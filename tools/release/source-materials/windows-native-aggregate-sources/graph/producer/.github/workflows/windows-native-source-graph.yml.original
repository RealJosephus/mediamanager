name: Current Windows native source graph

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  capture:
    name: Windows x64 static dependency source graph
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: '24.16.0'
      - name: Check original source containers and actual static dependency scope
        run: node --test tests/release/windows-native-build-inputs.test.js
      - name: Capture GNU Make dependency and source metadata without building packages
        run: node tools/release/capture-windows-native-source-graph.js .test-output/mxe-native-source-graph
      - name: Preserve actual graph, source identities, selected patches and failure evidence
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: windows-native-source-graph-${{ github.sha }}
          path: |
            .test-output/mxe-native-source-graph
            .test-output/mxe-native-work-*
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 30
