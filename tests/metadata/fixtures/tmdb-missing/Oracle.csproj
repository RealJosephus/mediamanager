<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App"/><Reference Include="$(JellyfinAssemblyDirectory)/*.dll"/></ItemGroup>
  <Target Name="RequireReferenceDirectory" BeforeTargets="ResolveReferences" Condition="'$(JellyfinAssemblyDirectory)' == ''"><Error Text="Set JellyfinAssemblyDirectory to the isolated reference build."/></Target>
</Project>
