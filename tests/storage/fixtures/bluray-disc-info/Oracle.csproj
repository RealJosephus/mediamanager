<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <RequiresJellyfinAssemblies>true</RequiresJellyfinAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(JellyfinDllDirectory)/*.dll" />
  </ItemGroup>
  <Target Name="RequireBdInfo" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(JellyfinDllDirectory)/BDInfo.dll')" Text="The isolated reference must supply its pinned BDInfo assembly." />
  </Target>
</Project>
