<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RequiresJellyfinAssemblies>true</RequiresJellyfinAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(JellyfinDllDirectory)/*.dll" />
    <None Include="$(JellyfinDllDirectory)/runtimes/win-x64/native/e_sqlite3.dll" Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(JellyfinDllDirectory)/runtimes/win-x64/native/libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireActualNativeHost" BeforeTargets="Compile">
    <Error Condition="!Exists('NativeScanHost.cs')" Text="An exact frozen copy of the shared actual NativeScanHost is required; a mocked traversal replacement is not supported." />
  </Target>
</Project>
