<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RequiresJellyfinAssemblies>true</RequiresJellyfinAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(JellyfinDllDirectory)/*.dll" />
    <Content Include="$(JellyfinDllDirectory)/runtimes/win-x64/native/libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(JellyfinDllDirectory)/runtimes/win-x64/native/libHarfBuzzSharp.dll" Link="libHarfBuzzSharp.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
