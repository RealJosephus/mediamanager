  "option": {
    "module": "rar5",
    "name": "independent-entry",
    "enabledBy": "archive-codec.c mm_create for fresh Book archive readers",
    "behavior": [
      "Directory enumeration and skipped entries consume their compressed payload without decompressing previous solid history.",
      "The selected entry initializes a zero dictionary, distance cache, previous length and solid offset.",
      "Payload CRC/BLAKE wrappers are absent, matching the actual async RarArchiveEntry.OpenEntryStreamAsync caller. Header/block parsing checks remain enabled."
    ],
    "scope": "Fresh native ComicImageProvider first selected-entry async stream. This does not claim the behavior of sync CRC-wrapped readers or multiple sequential streams sharing the same native Unpack instance."
  },
